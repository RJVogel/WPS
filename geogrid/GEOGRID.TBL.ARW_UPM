name = HGT_M
        priority = 1
        dest_type = continuous
        smooth_option = smth-desmth_special; smooth_passes=1
        fill_missing = 0.
        interp_option = topo_gmted2010_5m:average_gcell(4.0)+four_pt
        interp_option = topo_gmted2010_30s:average_gcell(4.0)+four_pt+average_4pt
        interp_option = topo_aster_30s:average_gcell(4.0)+four_pt+average_4pt
